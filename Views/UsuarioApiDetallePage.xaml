<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EscobarMatias_ExamenParcial_AppMovil_ll_Core.ViewModels;assembly=EscobarMatias_ExamenParcial_AppMovil_ll_Core"
             x:Class="EscobarMatias_ExamenParcial_AppMovil_ll.Views.UsuarioApiDetallePage"
             x:DataType="vm:UsuarioApiDetalleViewModel"
             Title="Detalle de usuario">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="4">

            <!-- Los datos llegan por navegación (IQueryAttributable) y se muestran con Data Binding.
                 Se muestran propiedades directas y de objetos anidados (Empresa, Direccion). -->
            <Label Text="{Binding Usuario.Nombre}"
                   FontSize="24"
                   FontAttributes="Bold" />
            <Label Text="{Binding Usuario.NombreUsuario, StringFormat='@{0}'}"
                   TextColor="{StaticResource ColorTextoSecundario}" />

            <Label Text="Email" FontAttributes="Bold" Margin="0,20,0,0" />
            <Label Text="{Binding Usuario.Email}" />

            <Label Text="Teléfono" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="{Binding Usuario.Telefono}" />

            <Label Text="Sitio web" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="{Binding Usuario.SitioWeb}" />

            <Label Text="Empresa" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="{Binding Usuario.Empresa.Nombre}" />

            <Label Text="Ciudad" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="{Binding Usuario.Direccion.Ciudad}" />

            <Label Text="Calle" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="{Binding Usuario.Direccion.Calle}" />

            <!-- GPS: INICIO -->
            <!-- Calcula la distancia entre la ubicación del dispositivo (GPS) y las coordenadas de este usuario.
                 El ViewModel pide el permiso y la ubicación a través de IUbicacionService. -->
            <Label Text="Coordenadas" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label Text="{Binding Usuario.Direccion.Geo.Latitud, StringFormat='Latitud: {0}'}" />
            <Label Text="{Binding Usuario.Direccion.Geo.Longitud, StringFormat='Longitud: {0}'}" />

            <Button Text="Calcular distancia desde mi ubicación"
                    Margin="0,20,0,0"
                    Command="{Binding CalcularDistanciaCommand}" />

            <ActivityIndicator IsRunning="{Binding EstaBuscandoUbicacion}"
                               IsVisible="{Binding EstaBuscandoUbicacion}" />

            <!-- Resultado o error: gris por defecto; el DataTrigger lo pinta de rojo si hubo un error. -->
            <Label Text="{Binding MensajeDistancia}"
                   IsVisible="{Binding HayMensajeDistancia}"
                   TextColor="{StaticResource ColorTextoSecundario}"
                   Margin="0,8,0,0">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding HayErrorDistancia}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource ColorError}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <!-- GPS: FIN -->

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>